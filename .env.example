# 複製此檔為 .env / .env.development 後填入實際值（.env* 已被 gitignore，不進版控）

# ── 平台基本 ──────────────────────────────
VITE_PORT = 8848
VITE_PUBLIC_PATH = /
VITE_ROUTER_HISTORY = "hash"
VITE_HIDE_HOME = false

# ── 後端 API（真後端模式才需要；填你自己的後端位址）──
VITE_GLOB_API_URL = ""
VITE_GLOB_IMG_URL = ""
VITE_GLOB_API_URL_PREFIX = ""
VITE_GLOB_UPLOAD_URL = "/upload"

# ── App 設定 ──────────────────────────────
VITE_GLOB_APP_TITLE = "BO_ADMIN"
VITE_GLOB_APP_SHORT_NAME = "bo_admin"
VITE_GLOB_APP_COUNTRY = "CN"
VITE_GLOB_APP_lang = "cn,en"
VITE_GLOB_APP_VD = "false"
VITE_GLOB_APP_SERIAL = ""
VITE_GLOB_APP_NEW_SERVER = ""
VITE_GLOB_SOUND_URL = ""

# ── 資料來源 ──────────────────────────────
# false = 走真後端(vite proxy 打 VITE_GLOB_API_URL)；true = 用 mock/*.ts 假資料
VITE_USE_MOCK = "true"
